# Origen del backend Nest (solo el origen, sin /api). El prefijo VITE_ es obligatorio en Vite.
# Local: vacío si usas proxy de Vite, o http://localhost:3000
# Producción (Opción A): frontend en Vercel, API en Railway → pon la URL pública del servicio Railway, p. ej.
# VITE_API_BASE=https://escuelapass-seguridad-institucional-production.up.railway.app
VITE_API_BASE=

# Zona horaria institucional (IANA). Debe coincidir con APP_TIMEZONE del backend.
# VITE_APP_TIMEZONE=America/Mexico_City

# Mapbox (requerido para CircuitArrivalMap e InstitutionMap en el frontend).
# Cree un token en https://account.mapbox.com/access-tokens/ — use un token de acceso público (pk.).
# Mismo valor puede alimentar variables del backend si ya usa Directions API u otras APIs Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=

# Opcional: estilo personalizado de Mapbox Studio (si se omite, se usa light-v11).
# Publicar el estilo (Publish) y usar token del MISMO usuario que el estilo — ver troubleshooting:
# https://docs.mapbox.com/help/tutorials/add-data-to-mapbox-style/
# Si el mapa en blanco en producción: restricciones de URL del token para tu dominio; CSP con worker-src 'self';
# el bundle ya fuerza el worker CSP (no depende de blob:).
# VITE_MAPBOX_STYLE_URL=mapbox://styles/tu-usuario/tu-estilo

# Firebase Cloud Messaging (push web). Opcional. Copie desde la consola Firebase (app web + VAPID).
# Tras definirlas, ejecute npm run sync:fcm-sw (o deje que predev/prebuild lo ejecuten) para generar public/firebase-messaging-sw.js.
# En Vercel, sin .env en el repo: prebuild toma estas claves desde las variables del proyecto (process.env) y genera el SW en CI.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_VAPID_KEY=

# Tras cambiar VITE_* en Vercel hay que generar un nuevo despliegue (build); el valor no se aplica en caliente.
