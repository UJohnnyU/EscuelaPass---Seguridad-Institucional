NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=escuela_pass
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

JWT_SECRET=change-me-access
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Opcional: tamaño máximo comprobante (bytes), por defecto ~5 MB
# VOUCHER_MAX_BYTES=5242880
