# Resumen en español:
# Software propietario de Murillo Martínez Jhon Kevin (2026). Queda prohibida la
# copia, modificación, distribución o explotación comercial sin autorización
# escrita. El POLI JIC cuenta con autorización limitada, no exclusiva y sin
# fines de lucro, para archivo y consulta académica de la versión entregada
# como Trabajo de Grado. Los componentes de terceros se rigen por sus propias
# licencias.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Conexión principal (producción recomendada: Postgres en Railway + backend Nest en Railway).
# Todas las migraciones, seeds y runtime usan DATABASE_URL cuando está definida.
# npm run migration:* carga automáticamente este .env desde la raíz del backend.
# En Railway: crea un recurso PostgreSQL y copia la variable DATABASE_URL al servicio del API
# (o usa la referencia ${{ Postgres.DATABASE_URL }} según el asistente de Railway).
# Ejemplo genérico:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway?sslmode=require
#
# Fallback local opcional (si no defines DATABASE_URL): variables DB_*.
# npm run db:apply usa DATABASE_URL o estas variables y aplica esquema + seed_dev + seed_demo_full en ESA base.
# Solo seed mínimo (sin demo): DB_SKIP_FULL_SEED=1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=escuela_pass
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

JWT_SECRET=change-me-access
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes del front (coma sin espacios). En producción incluye el dominio custom y el legacy Vercel:
# CORS_ORIGIN=https://escuelapass.com,https://www.escuelapass.com,https://escuela-pass-seguridad-instituciona-ashen.vercel.app
# FRONTEND_URL=https://escuelapass.com
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Circuito vial (Mapbox / mapa; el estado no cambia por GPS)
# MAPBOX_ACCESS_TOKEN=pk.xxxxxx
# SCHOOL_LATITUDE=4.6097
# SCHOOL_LONGITUDE=-74.0817
# CIRCUIT_ARRIVAL_RADIUS_KM=0.2

# Perfil institucional (por defecto si no hay filas en institution_settings; también vía GET/PATCH /settings/institution)
# INSTITUTION_NAME=Mi escuela
# INSTITUTION_ADDRESS=Calle 1
# INSTITUTION_CITY=Ciudad
# INSTITUTION_PHONE=+52 55 0000 0000
# INSTITUTION_EMAIL=contacto@escuela.edu

# Zona horaria institucional (IANA). Cierres de periodo, cartera, asistencia y crons usan esta zona.
# APP_TIMEZONE=America/Mexico_City

# Opcional: tamaño máximo comprobante (bytes), por defecto ~5 MB
# VOUCHER_MAX_BYTES=5242880

# E2E usa además `.env.e2e` para sobreescribir DB_NAME (ej: escuela_pass_test)
# Si no puedes ejecutar CREATE EXTENSION en el servidor: E2E_SKIP_EXTENSIONS=1 (E2E) o DB_SKIP_EXTENSIONS=1 (db:apply).

# Firebase Cloud Messaging (opcional; sin esto los avisos solo quedan en BD / bandeja in-app)
# Recomendado local: carpeta .secrets/ (está en .gitignore) y copiar aquí el JSON de la consola.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/ruta/absoluta/serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# (también admite el JSON completo codificado en base64 en una sola línea)
